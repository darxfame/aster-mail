{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aster Mail Module Palette",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base",
    "colors"
  ],
  "properties": {
    "base": {
      "enum": [
        "light",
        "dark"
      ]
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "surface",
        "surfaceAlt",
        "sidebar",
        "text",
        "mutedText",
        "border",
        "accent",
        "accentSurface",
        "onAccent"
      ],
      "properties": {
        "background": {
          "$ref": "#/$defs/color"
        },
        "surface": {
          "$ref": "#/$defs/color"
        },
        "surfaceAlt": {
          "$ref": "#/$defs/color"
        },
        "sidebar": {
          "$ref": "#/$defs/color"
        },
        "text": {
          "$ref": "#/$defs/color"
        },
        "mutedText": {
          "$ref": "#/$defs/color"
        },
        "border": {
          "$ref": "#/$defs/color"
        },
        "accent": {
          "$ref": "#/$defs/color"
        },
        "accentSurface": {
          "$ref": "#/$defs/color"
        },
        "onAccent": {
          "$ref": "#/$defs/color"
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    }
  }
}

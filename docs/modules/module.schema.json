{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aster Module API 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "version",
    "name",
    "type",
    "main",
    "permissions",
    "files"
  ],
  "properties": {
    "apiVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,79}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 40
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "type": {
      "enum": [
        "integration",
        "workflow",
        "panel",
        "hybrid"
      ]
    },
    "main": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_./-]*\\.m?js$",
      "maxLength": 200
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ui",
          "network",
          "storage",
          "calendar.read",
          "meeting.draft",
          "events",
          "meeting.launch",
          "auth.session"
        ]
      }
    },
    "networkOrigins": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      }
    },
    "networkHeaders": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[xX]-[a-zA-Z][a-zA-Z0-9-]{0,63}$"
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "slot"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,49}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "slot": {
            "enum": [
              "topbar",
              "calendar",
              "meeting.create",
              "internal"
            ]
          }
        }
      }
    },
    "views": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "file",
          "slot"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,49}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "file": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_./-]*\\.html$",
            "maxLength": 200
          },
          "slot": {
            "enum": [
              "panel",
              "meeting.create"
            ]
          },
          "height": {
            "type": "integer",
            "minimum": 100,
            "maximum": 500,
            "default": 220
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 199,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "meetingLinks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "origins"
      ],
      "properties": {
        "scheme": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9+.-]{1,31}$"
        },
        "origins": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "minItems": 1
        }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "origins",
        "identityOrigins",
        "capture",
        "authorization"
      ],
      "properties": {
        "type": {
          "const": "browser-token"
        },
        "path": {
          "type": "string",
          "pattern": "^/[a-zA-Z0-9_/-]*$",
          "maxLength": 200
        },
        "origins": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "minItems": 1
        },
        "identityOrigins": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "storage",
            "key",
            "tokenPath",
            "expiresAtPath"
          ],
          "properties": {
            "storage": {
              "enum": [
                "localStorage",
                "sessionStorage"
              ]
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "tokenPath": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
              }
            },
            "expiresAtPath": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
              }
            },
            "rejectPath": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
              }
            }
          }
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme"
          ],
          "properties": {
            "scheme": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9-]{0,31}$"
            }
          }
        }
      }
    },
    "optionalOrigins": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "includeSubdomains"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "maxLength": 253
          },
          "includeSubdomains": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
